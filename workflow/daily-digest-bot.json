    {
      "parameters": {
        "jsCode": "// Builds ONE Markdown message from the three sources.\n// The Merge node before this one only waits until all three branches have finished;\n// the data is read from each source node by name, so the order of merged items does not matter.\n\n// ---- Helpers ----\n// Telegram legacy Markdown treats _ * ` [ as formatting, so text from APIs/sheets is escaped.\nconst esc = (s) => String(s ?? '').replace(/([_*`\\[])/g, '\\\\$1');\n\n// Inside link text, escaping is not reliable, so formatting characters are removed instead.\nconst linkText = (s) => String(s ?? '').replace(/[_*`\\[\\]]/g, ' ').replace(/\\s+/g, ' ').trim();\n\nconst WEATHER = {\n  0: ['☀️', 'Clear sky'], 1: ['🌤', 'Mainly clear'], 2: ['⛅', 'Partly cloudy'], 3: ['☁️', 'Overcast'],\n  45: ['🌫', 'Fog'], 48: ['🌫', 'Fog'],\n  51: ['🌦', 'Light drizzle'], 53: ['🌦', 'Drizzle'], 55: ['🌦', 'Heavy drizzle'],\n  61: ['🌧', 'Light rain'], 63: ['🌧', 'Rain'], 65: ['🌧', 'Heavy rain'],\n  71: ['🌨', 'Light snow'], 73: ['🌨', 'Snow'], 75: ['❄️', 'Heavy snow'],\n  80: ['🌦', 'Rain showers'], 81: ['🌧', 'Rain showers'], 82: ['⛈', 'Violent showers'],\n  95: ['⛈', 'Thunderstorm'], 96: ['⛈', 'Thunderstorm with hail'], 99: ['⛈', 'Thunderstorm with hail'],\n};\n\nconst config = $('Config').first().json;\nconst today = $now.setZone('Asia/Baku').toFormat('cccc, d LLLL yyyy');\n\n// ---- Weather ----\nlet weatherText = '_Weather is unavailable right now._';\nconst w = $('Get weather').first()?.json;\nif (w && w.current) {\n  const [icon, label] = WEATHER[w.current.weather_code] ?? ['🌡', 'Weather'];\n  const u = w.current_units ?? {};\n  const max = w.daily?.temperature_2m_max?.[0];\n  const min = w.daily?.temperature_2m_min?.[0];\n  weatherText =\n    `${icon} ${label}, ${w.current.temperature_2m}${u.temperature_2m ?? '°C'}\\n` +\n    (max !== undefined ? `High ${max}° / Low ${min}°\\n` : '') +\n    `Wind ${w.current.wind_speed_10m} ${u.wind_speed_10m ?? 'km/h'}`;\n}\n\n// ---- News (first 3 headlines) ----\nconst news = $('Get news').all()\n  .map(i => i.json)\n  .filter(n => n.title && n.link)\n  .slice(0, 3);\nconst newsText = news.length\n  ? news.map((n, i) => `${i + 1}. [${linkText(n.title)}](${n.link})`).join('\\n')\n  : '_No headlines available right now._';\n\n// ---- To-dos (rows not marked as done) ----\nconst isDone = (v) => ['yes', 'true', 'done', '1'].includes(String(v ?? '').trim().toLowerCase());\nconst todos = $('Read to-dos').all()\n  .map(i => i.json)\n  .filter(t => t.task && !isDone(t.done));\nconst todoText = todos.length\n  ? todos.map(t => `• ${esc(t.task)}${t.due ? ` _(due ${esc(t.due)})_` : ''}`).join('\\n')\n  : '_Nothing on your list today. Enjoy!_';\n\n// ---- Message ----\nconst text =\n  `*Good morning!* 👋\\n${today}\\n\\n` +\n  `*Weather in ${esc(config.city)}*\\n${weatherText}\\n\\n` +\n  `*Top headlines*\\n${newsText}\\n\\n` +\n  `*Your to-dos*\\n${todoText}`;\n\nreturn [{ json: { text, chatId: config.chat_id } }];"
      },
